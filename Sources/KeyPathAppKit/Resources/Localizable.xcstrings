    "%@ finished, but KeyPath could not verify the final system state. Close and reopen the wizard before retrying." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は完了しましたが、KeyPathは最終的なシステムの状態を確認できませんでした。再試行する前に、セットアップアシスタントを閉じて開き直してください。"
          }
        }
      }
    },
    "%@ granted" : {
