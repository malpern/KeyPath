        }
      }
    },
    "Hold Space for Vim-style navigation: H/J/K/L for arrows, Y/P for copy/paste, U for undo, / for find. Release Space to type normally." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceを長押しでVimスタイルのナビゲーション: H/J/K/Lで矢印、Y/Pでコピー/ペースト、Uで取り消し、/で検索。Spaceを離すと通常どおり入力できます。"
          }
