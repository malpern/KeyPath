    },
    "This configuration is unsupported by the session runtime or contains an error" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成はセッションランタイムでサポートされていないか、エラーが含まれています"
          }
        }
      }
    },
    "This editor is not connected to the requested configuration file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエディタは要求された設定ファイルに接続されていません。"
          }
        }
