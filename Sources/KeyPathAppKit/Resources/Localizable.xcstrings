        }
      }
    },
    "KeyPath deactivated" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathを無効にしました"
          }
        }
      }
    },
    "KeyPath detected errors in your configuration file and has automatically created a backup and restored default settings.\n\nErrors found:\n%@\n\nYour original configuration has been backed up to:\n%@\n\nKeyPath is now using a default configuration (Caps Lock → Escape)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "KeyPath detected errors in your configuration file and has automatically created a backup and restored default settings.\n\nErrors found:\n%1$@\n\nYour original configuration has been backed up to:\n%2$@\n\nKeyPath is now using a default configuration (Caps Lock → Escape)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathは設定ファイルにエラーを検出したため、自動的にバックアップを作成し、デフォルトの設定に戻しました。\n\n見つかったエラー:\n%1$@\n\n元の構成のバックアップ先:\n%2$@\n\nKeyPathは現在デフォルトの構成 (Caps Lock → Escape) を使用しています。"
          }
        }
      }
    },
    "KeyPath did not replace your existing Caps Lock or Hyper behavior. You can keep exploring without changing it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPath did not replace your existing Caps Lock or Hyper behavior. You can keep exploring without changing it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathは既存のCaps LockやHyperの動作を置き換えませんでした。変更せずにこのまま試すことができます。"
          }
        }
      }
    },
    "KeyPath found errors in the configuration:\n\n%@\n\nWhat would you like to do?" : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathは構成にエラーを見つけました:\n\n%@\n\nどうしますか?"
          }
        }
      }
    },
    "KeyPath has been updated on disk, but you're still running the old version. Its keyboard runtime starts from the updated copy, so the two may not match.\n\nPlease restart KeyPath to load the updated version." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク上のKeyPathはアップデートされましたが、実行中なのは古いバージョンです。キーボードランタイムはアップデートされたコピーから起動するため、両者が一致しない可能性があります。\n\nKeyPathを再起動して、アップデートされたバージョンを読み込んでください。"
          }
        }
      }
    },
    "KeyPath is Off" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathはオフです"
          }
        }
      }
    },
    "KeyPath is not running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathは実行されていません。"
          }
        }
      }
    },
    "KeyPath is uninstalling; configuration changes are paused." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathをアンインストール中のため、構成の変更は一時停止しています。"
          }
        }
      }
    },
    "KeyPath keeps up to 5 recent rule and configuration backups. Older config-only backups can be opened for manual recovery." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathは最近のルールと構成のバックアップを最大5件保持します。古い設定ファイルのみのバックアップは、手動での復元用に開くことができます。"
          }
        }
      }
    },
    "KeyPath keyboard overlay" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathキーボードオーバーレイ"
          }
        }
      }
    },
    "KeyPath left your existing keyboard behavior untouched while showing how tap, hold, and shortcut layers fit together." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPath left your existing keyboard behavior untouched while showing how tap, hold, and shortcut layers fit together."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathは既存のキーボードの動作を変更せずに、タップ、長押し、ショートカットレイヤーがどのように組み合わさるかを示しました。"
