            "value" : "その文字はすでに使用されているため、KeyPathはランチャーを変更しませんでした。別の文字を選択して、もう一度お試しください。"
          }
        }
      }
    },
    "That prefix is Hyper" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That prefix is Hyper"
          }
        },
        "ja" : {
