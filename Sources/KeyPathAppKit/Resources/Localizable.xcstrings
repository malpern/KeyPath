    "Hold Caps Lock and press %@ to open %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Caps Lock and press %1$@ to open %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caps Lockを押したまま%1$@を押すと%2$@が開きます。"
          }
        }
      }
    },
    "Hold Caps Lock to prepare a clean shortcut prefix that other apps are unlikely to own." : {
      "comment" : "Short motivation for assigning Hyper to held Caps Lock.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Caps Lock to prepare a clean shortcut prefix that other apps are unlikely to own."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caps Lockを長押しすると、他のアプリと競合しにくいクリーンなショートカットの接頭辞を用意できます。"
          }
        }
      }
    },
    "Hold Caps Lock when you want its original action. You can change or turn this off in Rules at any time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Caps Lock when you want its original action. You can change or turn this off in Rules at any time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のアクションを使いたいときはCaps Lockを長押ししてください。この設定はいつでもルールで変更したりオフにしたりできます。"
          }
        }
      }
    },
    "Hold Caps Lock, press a letter you choose, and your app opens." : {
      "comment" : "Short explanation of the Quick Launcher interaction.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Caps Lock, press a letter you choose, and your app opens."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caps Lockを押したまま選んだ文字を押すと、アプリが開きます。"
          }
        }
      }
    },
    "Hold Caps Lock, press your chosen letter, then release. No Dock or mouse needed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Caps Lock, press your chosen letter, then release. No Dock or mouse needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caps Lockを押したまま、選んだ文字を押して離します。Dockもマウスも不要です。"
          }
        }
      }
    },
    "Hold Caps Lock, then press" : {
      "comment" : "Gesture reminder beside the onboarding Quick Launcher shortcut letter field.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Caps Lock, then press"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caps Lockを押したまま押す"
          }
        }
      }
    },
    "Hold F and your right hand becomes arrow keys. Tap F normally to type. I/J/K/L for arrows in an inverted-T layout you already know from your arrow keys.\n\nH and ; give you Home and End for jumping to the start or end of a line. U and O are Page Up and Page Down." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fを長押しすると、右手が矢印キーになります。文字を入力するときは普通にFをタップします。I/J/K/Lが矢印キーと同じ逆T字配列の矢印になります。\n\nHと;はHomeとEndで、行頭や行末にジャンプできます。UとOはPage UpとPage Downです。"
          }
        }
      }
    },
    "Hold F for Vim-style\nHJKL arrow keys." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fを長押しでVimスタイルの\nHJKL矢印キー。"
          }
        }
      }
    },
    "Hold F for arrow keys\nright under your fingers." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fを長押しで指のすぐ下に\n矢印キー。"
          }
        }
      }
    },
    "Hold F for arrow keys — your fingers never leave the home row" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fを長押しで矢印キー — 指がホームロウから離れません"
          }
        }
      }
    },
    "Hold Hyper to show launcher, release to hide" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyperを長押しでランチャーを表示、離すと非表示"
          }
