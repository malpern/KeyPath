          }
        }
      }
    },
    "'%@' applies everywhere except [%@] — imported as global rule (app exclusions not yet supported)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' applies everywhere except [%2$@] — imported as global rule (app exclusions not yet supported)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は[%2$@]を除くすべての場所に適用されます — グローバルルールとして読み込みました (アプリの除外はまだサポートされていません)"
          }
        }
      }
    },
    "'%@' overlaps with '%@' - may cause timing issues" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' overlaps with '%2$@' - may cause timing issues"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は「%2$@」と重複しています - タイミングの問題が発生する可能性があります"
          }
        }
      }
    },
    "'%@': %lld key(s) in macro sequence could not be translated and were dropped" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@': %2$lld key(s) in macro sequence could not be translated and were dropped"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」: マクロシーケンス内の%2$lld個のキーを変換できなかったため、削除しました"
          }
        }
      }
    },
    "'%@': has both a shell command and a tap action (to_if_alone) — tap action was dropped; only the shell command was imported" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」: シェルコマンドとタップアクション (to_if_alone) の両方があります — タップアクションは削除され、シェルコマンドのみ読み込みました"
          }
        }
      }
    },
    "'%@': modifier '%@' has no Kanata prefix equivalent and was dropped from the key expression" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
