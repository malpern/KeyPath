    "%lld milliseconds, %@. Lower values give faster fallback; higher values give an easier chord." : {
      "comment" : "Accessibility value for the chord press window. The first variable is milliseconds; the second is the preset name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld milliseconds, %2$@. Lower values give faster fallback; higher values give an easier chord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldミリ秒、%2$@。値を小さくするとフォールバックが速くなり、大きくするとコードを入力しやすくなります。"
          }
        }
      }
    },
