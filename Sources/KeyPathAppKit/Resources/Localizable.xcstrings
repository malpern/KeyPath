    " The engine rejected the restored rules." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " エンジンが復元されたルールを拒否しました。"
          }
        }
      }
    },
    " The restored rules are running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 復元されたルールが実行中です。"
          }
        }
      }
    },
    " The restored rules are saved and will apply when the engine is available." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 復元されたルールは保存されており、エンジンが利用可能になると適用されます。"
          }
        }
      }
    },
    " The restored rules could not be applied to the engine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 復元されたルールをエンジンに適用できませんでした。"
