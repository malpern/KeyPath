        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はどちらも「%2$@」キーに異なる動作を設定しています。"
          }
        }
      }
    },
    "%@ both map %@ on the %@ layer (%@). Only one can win." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ both map %2$@ on the %3$@ layer (%4$@). Only one can win."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はどちらも%3$@レイヤーで%2$@をマッピングしています (%4$@)。有効になるのは一方だけです。"
          }
        }
      }
    },
    "%@ both map %@ on the %@ layer. Only one can win." : {
      "localizations" : {
