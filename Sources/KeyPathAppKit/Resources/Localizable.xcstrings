    "This app is in KindaVim's ignore list." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリはKindaVimの無視リストに含まれています。"
          }
        }
      }
    },
    "This backup cannot be reproduced with the current keyboard, app rules or generation settings. Your current setup was kept." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップは、現在のキーボード、アプリのルール、または生成設定では再現できません。現在のセットアップは保持されました。"
          }
        }
      }
    },
    "This change needs attention first" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この変更は先に確認が必要です"
          }
        }
      }
    },
    "This configuration cannot run in the driverless session. %@ Turn that rule off or change it, then retry; existing rules were preserved. (Validator: %@.)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This configuration cannot run in the driverless session. %1$@ Turn that rule off or change it, then retry; existing rules were preserved. (Validator: %2$@.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成はドライバレスセッションでは実行できません。%1$@ そのルールをオフにするか変更してから再試行してください。既存のルールは保持されました。(バリデータ: %2$@)"
          }
        }
      }
    },
    "This configuration cannot run in the driverless session: %@. Edit the configuration and retry; existing rules were preserved." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この構成はドライバレスセッションでは実行できません: %@。構成を編集して再試行してください。既存のルールは保持されました。"
          }
