    "$%@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$%@"
          }
        }
      }
    },
    "%@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@\n\nScripts can run any command, and read or change your files. Run it only if you trust it. \"Always Allow\" remembers this script; if it changes, KeyPath asks again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nスクリプトは任意のコマンドを実行し、ファイルを読み取ったり変更したりできます。信頼できる場合にのみ実行してください。「常に許可」を選ぶとこのスクリプトを記憶します。スクリプトが変更されると、KeyPathは再度確認します。"
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ %@ offset" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ offset"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の%2$@オフセット"
          }
        }
      }
    },
    "%@ (PID: %lld)" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (PID: %2$lld)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (PID: %2$lld)"
          }
        }
      }
    },
    "%@ + %@" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ + %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ + %2$@"
          }
        }
      }
    },
    "%@ / effective input access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / 有効な入力アクセス"
          }
        }
      }
    },
    "%@ Automatic rollback failed. Please review your configuration." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 自動ロールバックに失敗しました。構成を確認してください。"
          }
        }
      }
    },
    "%@ Choose Space, Caps Lock, Tab, or Backtick once, and every layer follows your choice." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Space、Caps Lock、Tab、Backtickのいずれかを一度選ぶと、すべてのレイヤーがその選択に従います。"
          }
        }
      }
    },
    "%@ Choose Space, Caps Lock, Tab, or Backtick." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Space、Caps Lock、Tab、Backtickから選択してください。"
          }
        }
      }
    },
    "%@ Configuration recovery failed: %@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Configuration recovery failed: %2$@ %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 構成の回復に失敗しました: %2$@ %3$@"
          }
        }
      }
    },
    "%@ Hold your Hyper key and press a shortcut key, or switch Quick Launcher to Leader → L activation." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hyperキーを押したままショートカットキーを押すか、クイックランチャーの起動方法をLeader → Lに切り替えてください。"
          }
        }
      }
    },
    "%@ Hold your Hyper key, then press a shortcut key." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hyperキーを押したまま、ショートカットキーを押してください。"
          }
        }
      }
    },
    "%@ It is Space by default." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ デフォルトはSpaceです。"
          }
        }
      }
    },
    "%@ Layer" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@レイヤー"
          }
        }
      }
    },
    "%@ Mappings" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のマッピング"
          }
        }
