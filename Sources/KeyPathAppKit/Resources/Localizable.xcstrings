    "%@ Permission Required" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の権限が必要です"
          }
        }
      }
    },
    "%@ Powered by Kanata." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kanataを搭載しています。"
          }
        }
      }
    },
    "%@ Press %@, then L, then a shortcut key." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Press %2$@, then L, then a shortcut key."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@、L、ショートカットキーの順に押してください。"
          }
        }
      }
    },
    "%@ Tap your Hyper key to turn the launcher on or off, then press a shortcut key." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hyperキーをタップしてランチャーのオン/オフを切り替え、ショートカットキーを押してください。"
          }
        }
      }
    },
    "%@ The previous configuration could not be restored; a minimal safe file was written. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ The previous configuration could not be restored; a minimal safe file was written. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 以前の構成を復元できなかったため、最小限の安全なファイルを書き込みました。%2$@"
          }
        }
      }
    },
    "%@ Use it with a shortcut key to launch an app or website." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ショートカットキーと組み合わせて、アプリやWebサイトを起動できます。"
          }
        }
      }
    },
    "%@ already exists and is not a KeyPath command-line tool link." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでに存在し、KeyPathのコマンドラインツールのリンクではありません。"
          }
        }
      }
    },
    "%@ already exists and is not a KeyPath command-line tool link.\n\nRemove or rename the existing file before installing KeyPath's command-line tool." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでに存在し、KeyPathのコマンドラインツールのリンクではありません。\n\nKeyPathのコマンドラインツールをインストールする前に、既存のファイルを削除するか名前を変更してください。"
          }
        }
      }
    },
    "%@ already remaps Caps Lock" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでにCaps Lockをリマップしています"
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "Two rule names joined, e.g. 'Vim Navigation and Home Row Mods'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
