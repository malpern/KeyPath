    "That keyboard could not be set up for Caps Lock. It may have been unplugged; check the list and try again. Existing settings were kept." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのキーボードをCaps Lock用にセットアップできませんでした。取り外された可能性があります。リストを確認してもう一度お試しください。既存の設定は保持されました。"
          }
        }
      }
    },
    "That letter already has a shortcut. Choose another." : {
      "comment" : "Validation shown when the onboarding launcher shortcut letter is already assigned.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That letter already has a shortcut. Choose another."
