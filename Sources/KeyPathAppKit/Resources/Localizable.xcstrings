          }
        }
      }
    },
    "Hold any symbol key slightly longer to type its shifted variant — no Shift key needed. Tap for the symbol, hold for the shifted version." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記号キーを少し長めに押すと、Shift付きの文字を入力できます — Shiftキーは不要です。タップで記号、長押しでShift付きの文字になります。"
          }
        }
      }
    },
    "Hold delay" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
