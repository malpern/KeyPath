    "A KeyPath keyboard process did not stop. Nothing was removed. Restart your Mac, then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyPathのキーボードプロセスが停止しませんでした。何も削除されていません。Macを再起動してから、もう一度お試しください。"
          }
        }
      }
    },
    "A Numpad Under Your Hand" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手元のテンキー"
