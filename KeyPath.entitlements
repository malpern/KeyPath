<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Global keyboard interception and session process supervision require an unsandboxed app -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Apple Events support for application actions -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Network access for TCP communication with kanata -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Note: com.apple.security.inherit removed - not needed when sandboxing is disabled -->
    <!-- Process spawning works without this entitlement when app-sandbox is false -->
</dict>
</plist>