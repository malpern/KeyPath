#!/usr/bin/env python3
"""Require a real engine answer for the current layer.

The engine no longer listens on TCP (ADR-046): only the app that launched the
session worker may connect to it. So this asks the installed CLI, which asks the
app, which asks the engine. The name is kept for the lab scenarios that call it;
the printed JSON keeps its old shape: {"CurrentLayerName":{"name":...}}.
"""
import argparse
import json
import subprocess


def first_json_object(text: str):
    """The CLI can print log lines before its JSON; decode the first object."""
    decoder = json.JSONDecoder()
    for index, character in enumerate(text):
        if character == "{" and (index == 0 or text[index - 1] == "\n"):
            try:
                value, _ = decoder.raw_decode(text, index)
                return value
            except json.JSONDecodeError:
                continue
    return None


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--cli", default="/Applications/KeyPath.app/Contents/MacOS/keypath-cli")
    parser.add_argument("--timeout", type=float, default=10.0)
    args = parser.parse_args()
    try:
        result = subprocess.run([args.cli, "layer", "current", "--json"], capture_output=True,
                                text=True, timeout=args.timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SystemExit(f"kanata layer probe failed: {error}") from error
    if result.returncode != 0:
        raise SystemExit(f"kanata layer probe failed: keypath-cli exited {result.returncode}")
    payload = first_json_object(result.stdout)
    data = payload.get("data") if isinstance(payload, dict) else None
    layer = data.get("layer") if isinstance(data, dict) else None
    if not isinstance(layer, str) or not layer:
        raise SystemExit("kanata layer probe failed: layer response missing")
    print(json.dumps({"CurrentLayerName": {"name": layer}}, separators=(",", ":")))


if __name__ == "__main__":
    main()
