#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" >/dev/null && pwd -P)
REPO_ROOT=$(cd "$SCRIPT_DIR/../.." >/dev/null && pwd -P)
REMOTE_SCRIPT="$SCRIPT_DIR/remote.sh"
DEFAULT_HOST="clawd@keypath-lab-mini"

usage() {
    cat >&2 <<'EOF'
Usage: Scripts/lab/keypath-lab [--host HOST] <command> [options]

Commands:
  preflight
  create --macos 15|26|27 --lane managed-functional|unmanaged-ui --commit SHA --installer PATH [--ttl 2h] [--desktop] [--tart-usb-passthrough]
  install-app LEASE_ID
  console-login LEASE_ID
  reset-guest-password LEASE_ID
  secure-console-submit LEASE_ID
  rfb-pointer-probe LEASE_ID --x X --y Y
  desktop-bootstrap LEASE_ID [--install-tools]
  nameplate LEASE_ID enable|show|hide|status
  protected-click LEASE_ID --app APP --window TITLE (--x X --y Y | --ax-x X --ax-y Y) [--after-window TITLE] [--count 1|2]
  desktop-type LEASE_ID --text TEXT
  secure-dialog-input LEASE_ID --app APP --field LABEL [--submit BUTTON] [--already-focused]
  resume-managed-policy LEASE_ID
  run LEASE_ID -- COMMAND [ARG...]
  status LEASE_ID
  list
  lab-state
  artifacts LEASE_ID
  scenario LEASE_ID NAME
  destroy LEASE_ID
  cleanup [--dry-run]

The default host is clawd@keypath-lab-mini. Set KEYPATH_LAB_HOST or pass
--host to override it. Creation always requires an explicit full commit SHA and
an installer artifact. No command embeds or prompts for credentials.

VM creation is centrally admitted per provider. Exit 75 with `capacity_busy`
means another owned lease has the available slot; do not bypass this controller,
stop that lease, or adopt it. Continue non-VM work or retry after its owner
destroys it or its TTL expires. See docs/testing/remote-installer-lab.md.
EOF
    exit 2
}

die() {
    echo "keypath-lab: $*" >&2
    exit 1
}

host=${KEYPATH_LAB_HOST:-$DEFAULT_HOST}
if [[ ${1:-} == "--host" ]]; then
    [[ -n ${2:-} ]] || usage
    host=$2
    shift 2
fi

command=${1:-}
[[ -n $command ]] || usage
shift

remote() {
    local remote_command="/bin/zsh -s --" argument quoted
    for argument in "$@"; do
        printf -v quoted '%q' "$argument"
        remote_command="$remote_command $quoted"
    done
    ssh -o BatchMode=yes "$host" "$remote_command" < "$REMOTE_SCRIPT"
}

require_lease_id() {
    [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid lease id: $1"
}

LAB_DASHBOARD_UPDATER="$SCRIPT_DIR/update-lab-dashboard"
LAB_DASHBOARD_STATE=${KEYPATH_LAB_DASHBOARD_STATE:-/tmp/keypath-lab-state.json}

lab_update() {
    [[ ${KEYPATH_LAB_DASHBOARD_DISABLED:-0} == "1" ]] && return 0
    [[ -x $LAB_DASHBOARD_UPDATER ]] || return 0
    "$LAB_DASHBOARD_UPDATER" --state "$LAB_DASHBOARD_STATE" "$@" >/dev/null 2>&1 || true
}

new_run_id() {
    printf '%s-%s-%s' "$1" "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

tracked_remote() {
    local run_id=$1 title=$2 stage=$3 stage_label=$4 next=$5
    shift 5
    local exit_code
    lab_update --run-id "$run_id" --title "$title" --status active \
        --stage "$stage" --stage-label "$stage_label" --stage-status active \
        --next "$next" --event-tone working
    set +e
    remote "$@"
    exit_code=$?
    set -e
    if (( exit_code == 0 )); then
        lab_update --run-id "$run_id" --title "$title" --status passed \
            --stage "$stage" --stage-label "$stage_label" --stage-status passed \
            --next "$next" --event-tone success
    else
        lab_update --run-id "$run_id" --title "$title" --status failed \
            --stage "$stage" --stage-label "$stage_label" --stage-status failed \
            --detail "The lab command exited with status $exit_code." \
            --next "Inspect the latest controller output, then clean up any disposable resource." \
            --event-tone problem
    fi
    return "$exit_code"
}

observe_create_line() {
    local run_id=$1 usb_passthrough=$2 line=$3 lease_candidate
    if [[ $line == provisioning\ provider=* ]]; then
        lease_candidate=$(printf '%s\n' "$line" | sed -nE 's/.* lease=(cbx_[A-Za-z0-9]+).*/\1/p')
        lab_update --run-id "$run_id" --status active \
            --stage clone --stage-label "Clone VM" --stage-status active \
            --detail "$line" --next "Wait for the disposable guest to begin booting." \
            --resource "lease|${lease_candidate:-pending}|creating|Disposable lease requested" \
            --event-tone working
        if [[ $usb_passthrough == "1" ]]; then
            lab_update --run-id "$run_id" \
                --stage accessory --stage-label "USB listener" --stage-status active \
                --detail "The signed Tart app is registering for USB accessories." \
                --event-tone working
            lab_update --run-id "$run_id" --status waiting \
                --stage assign --stage-label "Assign keyboard" --stage-status waiting \
                --next "On the mini, choose Kinesis mWave from the Accessory Access menu." \
                --requires-human true --event-tone waiting
        fi
    elif [[ $line == leased\ cbx_* || $line == cbx_* ]]; then
        if [[ $usb_passthrough == "1" ]]; then
            lab_update --run-id "$run_id" \
                --stage accessory --stage-label "USB listener" --stage-status passed \
                --detail "Accessory Access registration completed." --event-tone success
            lab_update --run-id "$run_id" \
                --stage assign --stage-label "Assign keyboard" --stage-status passed \
                --detail "The accessory handoff is no longer blocking guest readiness." \
                --event-tone success
        fi
        lab_update --run-id "$run_id" --status active \
            --stage boot --stage-label "Boot + network" --stage-status active \
            --detail "$line" --next "Wait for guest networking and independent version verification." \
            --requires-human false --event-tone working
    elif [[ $line == tart\ ip*timed\ out* ]]; then
        lab_update --run-id "$run_id" --status failed \
            --stage boot --stage-label "Boot + network" --stage-status failed \
            --detail "$line" --next "Inspect USB assignment and the Tart guest boot path, then clean up." \
            --requires-human false --event-tone problem
    elif [[ $line == lease_id$'\t'* ]]; then
        lease_candidate=${line#*$'\t'}
        lab_update --run-id "$run_id" \
            --stage clone --stage-label "Clone VM" --stage-status passed \
            --detail "The disposable provider resource was created." \
            --event-tone success
        lab_update --run-id "$run_id" --status active \
            --stage boot --stage-label "Boot + network" --stage-status passed \
            --detail "Lease $lease_candidate is ready." \
            --resource "lease|$lease_candidate|ready|Owned disposable KeyPath lab lease" \
            --next "Install KeyPath or start the requested scenario." \
            --event-tone success
    fi
}

case "$command" in
    preflight)
        [[ $# -eq 0 ]] || usage
        run_id=$(new_run_id preflight)
        tracked_remote "$run_id" "Check lab readiness" host "Host ready" \
            "The mini is ready for a disposable VM run." preflight
        ;;
    create)
        macos=
        lane=
        commit=
        installer=
        ttl=2h
        desktop=0
        tart_usb_passthrough=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --macos) macos=${2:-}; shift 2 ;;
                --lane) lane=${2:-}; shift 2 ;;
                --commit) commit=${2:-}; shift 2 ;;
                --installer) installer=${2:-}; shift 2 ;;
                --ttl) ttl=${2:-}; shift 2 ;;
                --desktop) desktop=1; shift ;;
                --tart-usb-passthrough) tart_usb_passthrough=1; shift ;;
                *) usage ;;
            esac
        done
        [[ $macos == "15" || $macos == "26" || $macos == "27" ]] || die "--macos must be 15, 26, or 27"
        [[ $lane == "managed-functional" || $lane == "unmanaged-ui" ]] || die "--lane must be managed-functional or unmanaged-ui"
        [[ ! ($macos == "27" && $lane == "managed-functional") ]] || die "managed-functional is not yet supported on macOS 27"
        [[ $tart_usb_passthrough == "0" || $macos == "15" ]] || die "--tart-usb-passthrough requires --macos 15"
        [[ $commit =~ ^[0-9a-fA-F]{40}$ ]] || die "--commit must be a full 40-character SHA"
        [[ -f $installer ]] || die "installer not found: $installer"
        resolved=$(git -C "$REPO_ROOT" rev-parse --verify "$commit^{commit}")
        [[ $resolved == "$commit" ]] || die "commit does not resolve exactly: $commit"

        run_id=$(new_run_id create)
        lab_update --run-id "$run_id" --title "Create macOS $macos $lane lease" --status active \
            --stage source --stage-label "Prepare source" --stage-status active \
            --detail "Packaging commit ${commit:0:8} and the selected installer." \
            --next "Build the immutable source and installer archive." --event-tone working
        installer_sha=$(shasum -a 256 "$installer" | awk '{print $1}')
        archive_key="${commit}-${installer_sha}"
        temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/keypath-lab.XXXXXX")
        trap 'rm -rf "$temp_dir"' EXIT
        mkdir -p "$temp_dir/repo/.keypath-lab/installer"
        git -C "$REPO_ROOT" archive "$commit" | tar -x -C "$temp_dir/repo"
        installer_name=$(basename "$installer")
        [[ $installer_name =~ ^[A-Za-z0-9._-]+$ ]] || die "installer filename must contain only letters, numbers, dots, underscores, and dashes"
        cp "$installer" "$temp_dir/repo/.keypath-lab/installer/$installer_name"
        if [[ $lane == "managed-functional" ]]; then
            mkdir -p "$temp_dir/installer-extract"
            /usr/bin/ditto -x -k "$installer" "$temp_dir/installer-extract"
            [[ -d $temp_dir/installer-extract/KeyPath.app ]] || die "managed installer must contain KeyPath.app at its root"
            "$SCRIPT_DIR/mdm/generate-keypath-profiles" \
                --app "$temp_dir/installer-extract/KeyPath.app" \
                --output "$temp_dir/repo/.keypath-lab/managed-policy" >/dev/null
        fi
        cat > "$temp_dir/repo/.keypath-lab/source.tsv" <<EOF
keypath_commit	$commit
installer_name	$installer_name
installer_sha256	$installer_sha
EOF
        tar -czf "$temp_dir/archive.tgz" -C "$temp_dir" repo

        lab_update --run-id "$run_id" --stage source --stage-label "Prepare source" --stage-status passed \
            --detail "The immutable source and installer archive is ready." --event-tone success
        lab_update --run-id "$run_id" \
            --stage deploy --stage-label "Deploy" --stage-status active \
            --detail "Source archive is ready; transferring it to the lab mini." \
            --next "Upload and verify the immutable archive." --event-tone working
        upload_ticket=$(remote prepare-upload "$archive_key")
        [[ $upload_ticket == /tmp/keypath-lab.* ]] || die "host returned an invalid upload ticket"
        scp -q "$temp_dir/archive.tgz" "$host:$upload_ticket"
        remote install-archive "$upload_ticket" "$archive_key" "$commit" "$installer_sha" "$installer_name"
        lab_update --run-id "$run_id" --stage deploy --stage-label "Deploy" --stage-status passed \
            --detail "The mini accepted and verified the archive." --event-tone success
        lab_update --run-id "$run_id" \
            --stage host --stage-label "Host ready" --stage-status active \
            --detail "The mini accepted the archive; checking admission and capacity." \
            --next "Reserve provider capacity and clone the VM." --event-tone working
        set +e
        remote create "$macos" "$lane" "$archive_key" "$commit" "$installer_sha" "$installer_name" "$ttl" "$desktop" "$tart_usb_passthrough" 2>&1 |
            while IFS= read -r line || [[ -n $line ]]; do
                printf '%s\n' "$line"
                observe_create_line "$run_id" "$tart_usb_passthrough" "$line"
            done
        create_exit=${PIPESTATUS[0]}
        set -e
        if (( create_exit == 0 )); then
            lab_update --run-id "$run_id" \
                --stage host --stage-label "Host ready" --stage-status passed \
                --detail "Host admission and provider capacity checks passed." --event-tone success
            lab_update --run-id "$run_id" \
                --stage clone --stage-label "Clone VM" --stage-status passed \
                --detail "The disposable provider resource was created." --event-tone success
            lab_update --run-id "$run_id" --title "Create macOS $macos $lane lease" --status passed \
                --stage boot --stage-label "Boot + network" --stage-status passed \
                --next "Lease ready. Install KeyPath or start a scenario." \
                --requires-human false --event-tone success
        else
            lab_update --run-id "$run_id" --title "Create macOS $macos $lane lease" --status failed \
                --detail "Lease creation exited with status $create_exit." \
                --next "Inspect the final failed stage and verify disposable-resource cleanup." \
                --requires-human false --event-tone problem
            exit "$create_exit"
        fi
        ;;
    install-app)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        run_id=$(new_run_id install)
        tracked_remote "$run_id" "Install KeyPath in $1" test "Install app" \
            "Run a scenario or capture post-install evidence." install-app "$1"
        ;;
    console-login)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        remote console-login "$1"
        ;;
    reset-guest-password)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        remote reset-guest-password "$1"
        ;;
    secure-console-submit)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        remote secure-console-submit "$1"
        ;;
    rfb-pointer-probe)
        lease=${1:-}
        [[ -n $lease ]] || usage
        require_lease_id "$lease"
        shift
        x=
        y=
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --x) x=${2:-}; shift 2 ;;
                --y) y=${2:-}; shift 2 ;;
                *) usage ;;
            esac
        done
        [[ $x =~ ^[0-9]+$ && $y =~ ^[0-9]+$ ]] || usage
        remote rfb-pointer-probe "$lease" "$x" "$y"
        ;;
    desktop-bootstrap)
        lease=${1:-}
        [[ -n $lease ]] || usage
        require_lease_id "$lease"
        shift
        install_tools=0
        if [[ ${1:-} == "--install-tools" && $# -eq 1 ]]; then install_tools=1; shift; fi
        [[ $# -eq 0 ]] || usage
        remote desktop-bootstrap "$lease" "$install_tools"
        ;;
    nameplate)
        lease=${1:-}
        nameplate_action=${2:-}
        [[ -n $lease && $# -eq 2 ]] || usage
        require_lease_id "$lease"
        case "$nameplate_action" in enable|show|hide|status) ;; *) usage ;; esac
        remote nameplate "$lease" "$nameplate_action"
        ;;
    protected-click)
        lease=${1:-}
        [[ -n $lease ]] || usage
        require_lease_id "$lease"
        shift
        app=
        window=
        after_window=
        x=
        y=
        count=1
        coordinate_space=native
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --app) app=${2:-}; shift 2 ;;
                --window) window=${2:-}; shift 2 ;;
                --after-window) after_window=${2:-}; shift 2 ;;
                --x) x=${2:-}; shift 2 ;;
                --y) y=${2:-}; shift 2 ;;
                --ax-x) x=${2:-}; coordinate_space=ax; shift 2 ;;
                --ax-y) y=${2:-}; coordinate_space=ax; shift 2 ;;
                --count) count=${2:-}; shift 2 ;;
                *) usage ;;
            esac
        done
        [[ -n $app && -n $window && $x =~ ^[0-9]+$ && $y =~ ^[0-9]+$ && $count =~ ^[12]$ ]] || usage
        [[ -n $after_window ]] || after_window=$window
        remote protected-click "$lease" "$app" "$window" "$after_window" "$coordinate_space" "$x" "$y" "$count"
        ;;
    desktop-type)
        lease=${1:-}
        [[ -n $lease ]] || usage
        require_lease_id "$lease"
        shift
        [[ ${1:-} == "--text" && $# -eq 2 ]] || usage
        remote desktop-type "$lease" "$2"
        ;;
    secure-dialog-input)
        lease=${1:-}
        [[ -n $lease ]] || usage
        require_lease_id "$lease"
        shift
        app=
        field=
        submit=
        already_focused=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --app) app=${2:-}; shift 2 ;;
                --field) field=${2:-}; shift 2 ;;
                --submit) submit=${2:-}; shift 2 ;;
                --already-focused) already_focused=1; shift ;;
                *) usage ;;
            esac
        done
        [[ -n $app && -n $field ]] || usage
        remote secure-dialog-input "$lease" "$app" "$field" "$submit" "$already_focused"
        ;;
    resume-managed-policy)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        remote resume-managed-policy "$1"
        ;;
    run)
        lease=${1:-}
        [[ -n $lease ]] || usage
        require_lease_id "$lease"
        shift
        [[ ${1:-} == "--" ]] || usage
        shift
        [[ $# -gt 0 ]] || usage
        remote run "$lease" "$@"
        ;;
    status)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        remote status "$1"
        ;;
    list)
        [[ $# -eq 0 ]] || usage
        remote list
        ;;
    lab-state)
        [[ $# -eq 0 ]] || usage
        remote lab-state
        ;;
    artifacts)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        run_id=$(new_run_id evidence)
        tracked_remote "$run_id" "Capture evidence from $1" evidence "Capture evidence" \
            "Review the sanitized artifacts, then destroy the lease." artifacts "$1"
        ;;
    scenario)
        [[ $# -eq 2 ]] || usage
        require_lease_id "$1"
        [[ $2 =~ ^[a-z0-9-]+$ ]] || die "invalid scenario name: $2"
        run_id=$(new_run_id scenario)
        tracked_remote "$run_id" "Run $2 on $1" test "Run test" \
            "Capture evidence if the scenario passes; inspect ownership if it fails." scenario "$1" "$2"
        ;;
    destroy)
        [[ $# -eq 1 ]] || usage
        require_lease_id "$1"
        run_id=$(new_run_id cleanup)
        tracked_remote "$run_id" "Destroy lease $1" cleanup "Cleanup" \
            "The provider resource and owned worktree should now be absent." destroy "$1"
        ;;
    cleanup)
        if [[ ${1:-} == "--dry-run" && $# -eq 1 ]]; then
            remote cleanup --dry-run
        elif [[ $# -eq 0 ]]; then
            remote cleanup
        else
            usage
        fi
        ;;
    *) usage ;;
esac
