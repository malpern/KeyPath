#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" >/dev/null && pwd -P)
REPO_ROOT=$(cd "$SCRIPT_DIR/../.." >/dev/null && pwd -P)
FRAGMENT="$REPO_ROOT/docs/testing/keypath-matrix-dashboard.fragment.html"
RENDERER=${KEYPATH_VISUALIZE_RENDERER:-$HOME/.codex/plugins/cache/openai-bundled/visualize/1.0.15/skills/visualize/scripts/render.py}
OUTPUT="$REPO_ROOT/docs/testing/keypath-matrix-dashboard.html"

python3 "$RENDERER" "$FRAGMENT" "$OUTPUT"
perl -0pi -e "s/connect-src blob: data:/connect-src 'self' blob: data:/g" "$OUTPUT"
perl -0pi -e 's/sandbox="allow-scripts"/sandbox="allow-scripts allow-same-origin"/g' "$OUTPUT"
perl -0pi -e 's/width:100%;(?:max-width:736px;)?height/width:100%;max-width:1180px;height/g' "$OUTPUT"
python3 "$SCRIPT_DIR/add-dashboard-tabs.py" "$OUTPUT" --active matrix

grep -Fq "connect-src 'self' blob: data:" "$OUTPUT"
grep -Fq 'sandbox="allow-scripts allow-same-origin"' "$OUTPUT"
grep -Fq 'max-width:1180px' "$OUTPUT"
grep -Fq 'aria-current="page">Matrix runs' "$OUTPUT"
grep -Fq 'keypath-matrix-state.json' "$OUTPUT"
echo "$OUTPUT"
