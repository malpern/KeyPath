{
  "schemaVersion": 1,
  "scenario": "repair-kanata-service",
  "steps": [
    {
      "id": "repair-kanata-service",
      "action": [
        "/Applications/KeyPath.app/Contents/MacOS/keypath-cli",
        "system",
        "repair",
        "--json"
      ],
      "verify": [
        "../../../../Scripts/lab/assert-runtime-state",
        "ready",
        "--managed-policy-manifest",
        "/Library/KeyPathLab/managed-policy/manifest.json"
      ]
    }
  ]
}
