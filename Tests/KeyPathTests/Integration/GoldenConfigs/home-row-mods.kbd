;; Generated by KeyPath
;; Enabled: macOS Function Keys, Home Row Mods

(defcfg
  process-unmapped-keys yes
  managed-repeat yes
  managed-repeat-unlisted no
  tap-hold-require-prior-idle 150
)
;; SAFETY: This configuration is auto-generated. Do not edit by hand.
;; SAFETY: Only explicitly enabled mappings are written to this file.
;; EMERGENCY EXIT: Hold Left Control + Space + Escape to force-quit Kanata
#|
================================================================================
TIMING VARIABLES
================================================================================
|#

(defvar
  tap-timeout   200
  hold-timeout  200
  chord-timeout  50
)

(defhands
  (left q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; n m , . /))

#|
================================================================================
PHYSICAL KEYBOARD LAYOUT - DEFSRC
================================================================================
|#

(defsrc
  ;; === Collection: macOS Function Keys (enabled) ===
  ;; UUID: <UUID>
  ;; Description: Preserves brightness, volume, media, and system control keys (F1-F12).
  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12

  ;; === Collection: Home Row Mods (enabled) ===
  ;; UUID: <UUID>
  ;; Description: Tap for letters, hold for modifiers or layers
  a s d f j k l ;
)
#|
================================================================================
ALIAS DEFINITIONS (defalias)
================================================================================
|#

(defalias
  ;; --- Tap-Hold Behaviors ---
  beh_base_; (tap-hold-opposite-hand 150 ; rsft)  ;; tap: ;  hold: rsft
  beh_base_a (tap-hold-opposite-hand 150 a lsft)  ;; tap: a  hold: lsft
  beh_base_d (tap-hold-opposite-hand 150 d lalt)  ;; tap: d  hold: lalt
  beh_base_f (tap-hold-opposite-hand 150 f lmet)  ;; tap: f  hold: lmet
  beh_base_j (tap-hold-opposite-hand 150 j rmet)  ;; tap: j  hold: rmet
  beh_base_k (tap-hold-opposite-hand 150 k ralt)  ;; tap: k  hold: ralt
  beh_base_l (tap-hold-opposite-hand 150 l rctl)  ;; tap: l  hold: rctl
  beh_base_s (tap-hold-opposite-hand 150 s lctl)  ;; tap: s  hold: lctl
)

#|
================================================================================
LAYER DEFINITIONS
================================================================================
|#

(deflayer base
  ;; === Collection: macOS Function Keys (enabled) ===
  ;; UUID: <UUID>
  ;; Description: Preserves brightness, volume, media, and system control keys (F1-F12).
  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12

  ;; === Collection: Home Row Mods (enabled) ===
  ;; UUID: <UUID>
  ;; Description: Tap for letters, hold for modifiers or layers
  @beh_base_a @beh_base_s @beh_base_d @beh_base_f @beh_base_j @beh_base_k @beh_base_l @beh_base_;
)