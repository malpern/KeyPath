+/// Schedules optional startup work on a later main-actor turn. A prerequisite can
+/// keep nonessential initialization behind required launch work (such as runtime start).
+@MainActor
+enum DeferredApplicationLaunchWork {
+    static func schedule(
+        after prerequisite: @escaping @MainActor () async -> Void = {},
+        then operation: @escaping @MainActor () -> Void
+    ) {
+        Task { @MainActor in
+            await prerequisite()
+            await Task.yield()
+            operation()
+        }
+    }
+}
