+@MainActor
+final class DeferredApplicationLaunchWorkTests: XCTestCase {
+    func testOptionalWorkDoesNotRunInline() async {
+        let completed = expectation(description: "deferred work completes")
+        var schedulingCallReturned = false
+        var workRan = false
+
+        DeferredApplicationLaunchWork.schedule {
+            XCTAssertTrue(schedulingCallReturned)
+            workRan = true
+            completed.fulfill()
+        }
+
+        XCTAssertFalse(workRan, "Optional initialization must not run in the launch callback stack")
+        schedulingCallReturned = true
+        await fulfillment(of: [completed], timeout: 1.0)
+        XCTAssertTrue(workRan)
+    }
+
+    func testOptionalWorkWaitsUntilRequiredAsyncStartupFinishes() async {
+        let completed = expectation(description: "deferred work completes")
+        var events: [String] = []
+
+        DeferredApplicationLaunchWork.schedule(after: {
+            events.append("runtime-start-begin")
+            await Task.yield()
+            events.append("runtime-start-end")
+        }) {
+            events.append("optional-audio-init")
+            XCTAssertEqual(
+                events,
+                [
+                    "launch-callback-continues",
+                    "runtime-start-begin",
+                    "runtime-start-end",
+                    "optional-audio-init",
+                ]
+            )
+            completed.fulfill()
+        }
+
+        events.append("launch-callback-continues")
+        await fulfillment(of: [completed], timeout: 1.0)
+    }
+}
