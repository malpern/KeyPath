 # Privileged commands are confined to a ready, unexpired, owned guest.
+transport_diagnostic() {
+  local diagnostic_nonce=${VM_LAB_TRANSPORT_DIAGNOSTIC_NONCE:-} stage=$1 result=$2
+  [[ -n "$diagnostic_nonce" ]] || return 0
+  [[ "$diagnostic_nonce" =~ '^[0-9a-f]{32}$' ]] || return 64
+  [[ "$stage" == guest-root.enter || "$stage" == owned-guard.passed ||
+     "$stage" == provider.exec.enter || "$stage" == provider.exec.exit ]] || return 64
+  [[ "$result" == <-> ]] && (( result <= 255 )) || return 64
+  printf '\nVM_LAB_DIAG_V1 %s %s %s\n' "$diagnostic_nonce" "$stage" "$result" >&2 || true
+}
