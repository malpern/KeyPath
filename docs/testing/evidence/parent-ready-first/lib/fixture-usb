#!/usr/bin/env python3
"""Verify the named CAFE:4010 fixture in an owned guest. Never route or steal USB."""
import json, plistlib, subprocess, sys
PRL='/Applications/Parallels Desktop.app/Contents/MacOS/prlctl'
SRV='/Applications/Parallels Desktop.app/Contents/MacOS/prlsrvctl'
def run(args):
    return subprocess.run(args, capture_output=True, check=True, timeout=20).stdout

def select(devices):
    matches=[d for d in devices if d.get('Name') == 'KeyPath Physical HID Fixture'
             and d.get('System name','').split('|')[1:3] == ['cafe','4010']]
    if len(matches)!=1: raise RuntimeError('exactly one CAFE:4010 fixture required')
    if matches[0].get('Compatible-with-macOS-VM') != 'YES':
        raise RuntimeError('fixture is not compatible with macOS guest')
    return matches[0]

def guest_device(resource):
    raw=run([PRL,'exec',resource,'/usr/sbin/ioreg','-a','-r','-c','IOHIDDevice'])
    devices=plistlib.loads(raw)
    def walk(value):
        if isinstance(value,dict):
            if value.get('VendorID')==0xCAFE and value.get('ProductID')==0x4010:
                yield {k:value.get(k) for k in ('Product','VendorID','ProductID','SerialNumber','Transport','PrimaryUsage')}
            for child in value.values(): yield from walk(child)
        elif isinstance(value,list):
            for child in value: yield from walk(child)
    matches=list(walk(devices))
    if len(matches)!=1 or matches[0]['Transport'] != 'USB' or matches[0]['PrimaryUsage'] != 6:
        raise RuntimeError('guest does not enumerate exactly one fixture USB keyboard')
    return matches[0]

def main():
    resource,action,record_name=sys.argv[1:]
    if action not in ('status','verify'): raise RuntimeError('only read-only status or verify supported')
    device=select(json.loads(run([SRV,'usb','list','--json'])))
    observed=None
    try:
        observed=guest_device(resource)
        serial=device['System name'].split('|')[-1]
        if observed.get('SerialNumber')!=serial:raise RuntimeError('USB serial mismatch')
        if device.get('Connected-To-Vm')!='YES':raise RuntimeError('provider does not confirm attachment')
        if device.get('Used-By-Vm-Uuid','').strip('{}').lower()!=resource.strip('{}').lower():raise RuntimeError('provider resource mismatch')
        eligible=True;reason=''
    except Exception as error:
        eligible=False;reason=str(error)
    print(json.dumps({'inputEligible':eligible,'device':device,'guestDevice':observed,'reason':reason}))
    return 0 if action=='status' or eligible else 79

if __name__=='__main__':
    try:sys.exit(main())
    except Exception as error:
        print(json.dumps({'inputEligible':False,'error':str(error)}));sys.exit(1)
